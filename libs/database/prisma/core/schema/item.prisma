/// =======================================================
/// 1. ITEM (Produto Pai / Raiz do Catálogo)
/// =======================================================
model Item {
  id              String    @id @default(ulid())
  imageId         String?
  establishmentId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// O basePrice APENAS é usado se o item NÃO tiver variantes.
  basePrice       Decimal?  @db.Decimal(10, 2)
  deletedAt       DateTime?
  posCategoryId   String?
  sku             String?

  unit     UnitType @default(UNIT)
  quantity Float    @default(1)

  status              ItemStatus           @default(ACTIVE)
  taxTableId          String
  allergens           ItemAllergen[]
  establishment       Establishment        @relation(fields: [establishmentId], references: [id])
  image               Image?               @relation("ImageItem", fields: [imageId], references: [id])
  posCategory         POSCategory?         @relation(fields: [posCategoryId], references: [id])
  taxTable            TaxTable             @relation(fields: [taxTableId], references: [id])
  modifierGroups      ItemModifierGroup[]
  itemModifierOptions ItemModifierOption[]
  translations        ItemTranslation[]
  variants            ItemVariant[]
  itemVariantGroups   ItemVariantGroup[]
  menuItemPositions   MenuItemPosition[]
  nutritionInfo       ItemNutritionInfo?
  discounts           DiscountTarget[]
  requiredItemRules   BuyXGetYRule[]       @relation("RequiredItem")
  rewardItemRules     BuyXGetYRule[]       @relation("RewardItem")
  marketingTag        MarketingTag?
  spiceLevel          SpiceLevel?
  isFeatured          Boolean              @default(false)
  hasAlcohol          Boolean              @default(false)
  attributes          ItemAttribute[]
  vendusProductId     Int?

  @@unique([establishmentId, sku])
  @@index([establishmentId, status])
  @@index([deletedAt])
}

model ItemNutritionInfo {
  id            String   @id @default(ulid())
  energyKcal    Float?
  fat           Float?
  saturatedFat  Float?
  carbohydrates Float?
  sugars        Float?
  fiber         Float?
  protein       Float?
  salt          Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  itemId        String?  @unique
  item          Item?    @relation(fields: [itemId], references: [id])
}

model VariantNutrionalInfo {
  id            String       @id @default(ulid())
  energyKcal    Float?
  fat           Float?
  saturatedFat  Float?
  carbohydrates Float?
  sugars        Float?
  fiber         Float?
  protein       Float?
  salt          Float?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  itemVariantId String?      @unique
  itemVariant   ItemVariant? @relation(fields: [itemVariantId], references: [id])
}

model ItemTranslation {
  id               String  @id @default(ulid())
  locale           String
  name             String
  shortDescription String?
  description      String?
  itemId           String
  item             Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, locale])
}

/// A. O Dicionário de Opções (Ex: "Pequena", "Média", "33cl")
model VariantOption {
  id              String                     @id @default(ulid())
  establishmentId String?
  isGlobal        Boolean                    @default(false)
  isActive        Boolean                    @default(true)
  quantity        Float
  unit            UnitType
  itemVariants    ItemVariant[]
  establishment   Establishment?             @relation(fields: [establishmentId], references: [id])
  translations    VariantOptionTranslation[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([establishmentId])
}

model VariantOptionTranslation {
  id              String        @id @default(ulid())
  variantOptionId String
  locale          String
  name            String
  variantOption   VariantOption @relation(fields: [variantOptionId], references: [id], onDelete: Cascade)

  @@unique([variantOptionId, locale])
}

/// B. O Grupo Local (Simetria perfeita com Modifiers)
/// Ex: "Escolha o Tamanho"
model ItemVariantGroup {
  itemId       String
  position     Int                           @default(0)
  id           String                        @id @default(ulid())
  variants     ItemVariant[]
  item         Item                          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  translations ItemVariantGroupTranslation[]

  @@index([itemId])
}

model ItemVariantGroupTranslation {
  id                 String           @id @default(ulid())
  itemVariantGroupId String
  locale             String
  name               String
  itemVariantGroup   ItemVariantGroup @relation(fields: [itemVariantGroupId], references: [id], onDelete: Cascade)

  @@unique([itemVariantGroupId, locale])
}

model ItemVariant {
  id                 String                @id @default(ulid())
  itemId             String
  price              Decimal               @db.Decimal(10, 2)
  sku                String?
  isDefault          Boolean               @default(false)
  isActive           Boolean               @default(true)
  imageId            String?
  itemVariantGroupId String
  position           Int                   @default(0)
  variantOptionId    String
  allergens          ItemVariantAllergen[]
  modifierOptions    ItemModifierOption[]
  image              Image?                @relation("ItemVariantImage", fields: [imageId], references: [id])
  item               Item                  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  group              ItemVariantGroup      @relation(fields: [itemVariantGroupId], references: [id], onDelete: Cascade)
  variantOption      VariantOption         @relation(fields: [variantOptionId], references: [id])
  nutritionInfo      VariantNutrionalInfo?
  deletedAt          DateTime?

  @@unique([itemVariantGroupId, variantOptionId])
  @@unique([id, sku])
  @@index([itemId])
  @@index([deletedAt])
}

/// A. Grupo de Modificadores (As perguntas feitas ao cliente)
model ItemModifierGroup {
  id           String                         @id @default(ulid())
  itemId       String
  minSelection Int                            @default(0)
  maxSelection Int?
  position     Int                            @default(0)
  displayMode  ModifierDisplayMode            @default(RADIO)
  isActive     Boolean                        @default(true)
  item         Item                           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  translations ItemModifierGroupTranslation[]
  options      ItemModifierOption[]
  deletedAt    DateTime?

  @@index([deletedAt])
}

model ItemModifierGroupTranslation {
  id              String            @id @default(ulid())
  modifierGroupId String
  locale          String
  name            String
  modifierGroup   ItemModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  deletedAt       DateTime?

  @@unique([modifierGroupId, locale])
}

/// B. O Dicionário de Addons Simples (Instruções de cozinha, extras)
/// Coisas que não existem como Item (Ex: "Massa Fina", "Sem Gelo")
model Addon {
  id                  String               @id @default(ulid())
  establishmentId     String?
  isActive            Boolean              @default(true)
  isGlobal            Boolean              @default(false)
  establishment       Establishment?       @relation(fields: [establishmentId], references: [id])
  translations        AddonTranslation[]
  itemModifierOptions ItemModifierOption[]

  @@index([establishmentId])
  @@index([isGlobal])
}

model AddonTranslation {
  id      String @id @default(ulid())
  addonId String
  locale  String
  name    String
  addon   Addon  @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([addonId, locale])
}

model Allergen {
  id                   String                @id @default(ulid())
  code                 AllergenCode          @unique
  itemAllergens        ItemAllergen[]
  itemVariantAllergens ItemVariantAllergen[]
}

model ItemAllergen {
  id         String   @id @default(ulid())
  itemId     String
  allergenId String
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, allergenId])
}

model ItemVariantAllergen {
  id            String   @id @default(ulid())
  itemVariantId String
  allergenId    String
  allergen      Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  itemVariant ItemVariant @relation(fields: [itemVariantId], references: [id], onDelete: Cascade)

  @@unique([itemVariantId, allergenId])
}

/// C. As Opções do Modificador (Polimorfismo!)
/// REGRA SQL (CONSTRAINT): Apenas 1 alvo pode ser preenchido (addonId, productId ou itemVariantId)
model ItemModifierOption {
  id              String            @id @default(ulid())
  modifierGroupId String
  price           Decimal?          @db.Decimal(10, 2)
  position        Int               @default(0)
  defaultQuantity Int               @default(0)
  minQuantity     Int               @default(0)
  maxQuantity     Int               @default(1)
  addonId         String?
  productId       String?
  itemVariantId   String?
  addon           Addon?            @relation(fields: [addonId], references: [id])
  itemVariant     ItemVariant?      @relation(fields: [itemVariantId], references: [id])
  group           ItemModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  product         Item?             @relation(fields: [productId], references: [id])

  @@index([modifierGroupId])
}

enum ItemStatus {
  ACTIVE
  UNAVAILABLE
  DRAFT
  INACTIVE
}

enum AllergenCode {
  CELERY
  CRUSTACEAN
  EGG
  FISH
  GLUTEN
  LUPINS
  MILK
  MUSTARD
  NUTS
  PEANUTS
  SESAME
  SHELLFISH
  SOY
  SULFITES
}

enum ModifierDisplayMode {
  RADIO
  CHECKBOX
  QUANTITY
}

enum SpiceLevel {
  LOW
  MEDIUM
  HIGH
  EXTRA_HOT
}

model ItemAttribute {
  id     String        @id @default(ulid())
  type   AttributeType
  itemId String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, type])
}

enum AttributeType {
  VEGAN
  VEGETARIAN
  GLUTEN_FREE
  DAIRY_FREE
  HALAL
  KOSHER
}

enum MarketingTag {
  BESTSELLER
  NEW
  POPULAR
  LIMITED
}

enum UnitType {
  // --- Serving ---
  PORTION
  HALF
  SLICE
  PIECE
  PLATE
  BOWL
  UNIT
  PAX
  BALL //Bolas de Gelado

  // --- Drinks ---
  GLASS
  CUP
  SHOT
  MUG

  // --- Containers ---
  BOTTLE
  CAN

  // --- Measurements ---
  MILLILITER
  CENTILITER
  LITER
  GRAM
  KILOGRAM
  OUNCE
  POUND
}

