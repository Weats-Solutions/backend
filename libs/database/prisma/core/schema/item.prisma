// ==========================================
// 1. O NÚCLEO (ITEM)
// ==========================================

model Item {
    id              String  @id @default(ulid())
    // O nome aqui serve como "Nome Interno" (para o staff/POS na língua principal)
    name            String
    description     String? // Descrição interna
    imageId         String?
    establishmentId String
    posCategoryId   String?

    // Relações
    variants       ItemVariant[]
    modifierGroups ItemModifierGroup[]

    // TRADUÇÕES DO ITEM (Nome e Descrição para o Menu)
    translations ItemTranslation[]
    Image        Image?            @relation("ImageItem", fields: [imageId], references: [id])

    posCategory              POSCategory?         @relation(fields: [posCategoryId], references: [id])
    establishment            Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
    modifierOptionsAsProduct ItemModifierOption[] @relation("ProductAsModifier")
    menuItemPositions        MenuItemPosition[]
}

model ItemTranslation {
    id     String @id @default(ulid())
    itemId String
    locale String // "en", "fr", "es"

    name        String // O que aparece no menu QR
    description String?

    item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

    @@unique([itemId, locale]) // Garante 1 tradução por língua por item
}

// ==========================================
// 2. VARIANTES (Tamanhos, Pontos, Tipos)
// ==========================================

model ItemVariant {
    id              String  @id @default(ulid())
    itemId          String
    variantOptionId String
    price           Float // Preço Base
    isDefault       Boolean @default(false)

    item   Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
    option VariantOption @relation(fields: [variantOptionId], references: [id])

    @@unique([itemId, variantOptionId])
}

model VariantOption {
    id              String      @id @default(ulid())
    name            String
    code            String?     @unique
    type            VariantType @default(SIZE)
    establishmentId String?
    quantity        Float? // Para guardar "20", "33", "1"
    unit            String? // Para guardar "CL", "L", "KG"

    variants ItemVariant[]
    isGlobal Boolean       @default(false)

    translations  VariantOptionTranslation[]
    establishment Establishment?             @relation(fields: [establishmentId], references: [id])
}

enum VariantType {
    SIZE // Frontend desenha: Selector de Tamanho (Copo, Litros)
    PREPARATION // Frontend desenha: Lista de Ponto de Carne
    FLAVOR // Frontend desenha: Bolinhas de cor ou lista de sabores
    COLOR // Frontend desenha: Selector de cor
    OTHER
}

model VariantOptionTranslation {
    id              String @id @default(ulid())
    variantOptionId String
    locale          String
    name            String // ex: "Well Done", "Bien Cuit"

    variantOption VariantOption @relation(fields: [variantOptionId], references: [id], onDelete: Cascade)

    @@unique([variantOptionId, locale])
}

// ==========================================
// 3. MODIFICADORES E GRUPOS (Acompanhamentos)
// ==========================================

enum ModifierDisplayMode {
    RADIO // Para escolha única obrigatória (Ponto da Carne)
    CHECKBOX // Para lista de Sim/Não (Pizza Toppings, Remover Ingredientes)
    QUANTITY // Para incrementos (Extras do Burger)
}

model ItemModifierGroup {
    id     String @id @default(ulid())
    itemId String

    name String // Nome Interno (ex: "Escolha o Molho")
    code String? // ex: "SAUCE_CHOICE"

    displayMode  ModifierDisplayMode @default(RADIO)
    minSelection Int                 @default(0)
    maxSelection Int?
    position     Int                 @default(0)

    item    Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
    options ItemModifierOption[]

    // TRADUÇÕES DO TÍTULO DO GRUPO (Importante!)
    translations ItemModifierGroupTranslation[]
}

model ItemModifierGroupTranslation {
    id              String @id @default(ulid())
    modifierGroupId String
    locale          String
    name            String // ex: "Choose your Sauce", "Choisissez votre sauce"

    modifierGroup ItemModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

    @@unique([modifierGroupId, locale])
}

model ItemModifierOption {
    id              String @id @default(ulid())
    modifierGroupId String

    // Configurações de Venda neste contexto
    price    Float? // Se null, usa o preço original do item. Se definido (ex: 0), sobrepõe.
    position Int    @default(0)

    // Quantidade permitida para esta opção específica
    minQuantity     Int @default(0) // Mínimo que pode selecionar (normalmente 0)
    maxQuantity     Int @default(1) // Máximo que pode selecionar (1 = radio, >1 = counter)
    defaultQuantity Int @default(0) // Quantidade pré-selecionada (ex: 2 fatias incluídas, extras custam mais)

    // --- A MUDANÇA ESTÁ AQUI (Campos Opcionais) ---

    // CASO 1: É uma instrução ou ingrediente simples (ex: "Sem Cebola")
    addonId String?
    addon   Addon?  @relation(fields: [addonId], references: [id])

    // CASO 2: É um Item real que já existe (ex: "Batata Frita", "Coca-Cola")
    productId String?
    product   Item?   @relation("ProductAsModifier", fields: [productId], references: [id])

    group ItemModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

    // Regra de Validação (Database constraint se possível, ou lógica de app): 
    // Tem de ter OU addonId OU productId, nunca os dois.
    @@index([modifierGroupId])
    @@index([productId])
    @@index([addonId])
}

// ==========================================
// 4. BIBLIOTECA DE EXTRAS (ADDONS)
// ==========================================

model Addon {
    id              String               @id @default(ulid())
    name            String // Nome Interno (ex: "Batata Frita")
    establishmentId String?
    modifierOptions ItemModifierOption[]
    isGlobal        Boolean              @default(false)

    // TRADUÇÕES DOS EXTRAS
    translations  AddonTranslation[]
    establishment Establishment?     @relation(fields: [establishmentId], references: [id])
}

model AddonTranslation {
    id      String @id @default(ulid())
    addonId String
    locale  String
    name    String // ex: "French Fries", "Frites"

    addon Addon @relation(fields: [addonId], references: [id], onDelete: Cascade)

    @@unique([addonId, locale])
}
