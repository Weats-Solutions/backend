# Weats Backend - Environment Variables
# Copy to .env and fill in your actual values
#
# NOTE: PostgreSQL, Redis são serviços externos do Dokploy
#       Este docker-compose contém apenas: Gateway, Webhooks, Dashboard

# ─────────────────────────────────────────────────────────────────
# NODE ENVIRONMENT
# ─────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_URL=https://seu-dominio.com

# ─────────────────────────────────────────────────────────────────
# EXTERNAL SERVICES (Dokploy)
# ─────────────────────────────────────────────────────────────────

# PostgreSQL CORE (Dokploy service)
CORE_DB_URL=postgresql://user:password@dokploy-postgres-host:5432/core

# PostgreSQL ORDERS (Dokploy service)
ORDERS_DB_URL=postgresql://user:password@dokploy-postgres-host:5432/orders-db

# Redis (Dokploy service)
REDIS_HOST=dokploy-redis-host
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password_here
REDIS_EMAIL_DB=1
REDIS_IMAGES_DB=2
REDIS_WEBHOOK_DB=3
REDIS_CACHE_DB=4
REDIS_QRCODES_DB=5
REDIS_SESSION_DB=6

# ─────────────────────────────────────────────────────────────────
# CLERK AUTHENTICATION
# https://dashboard.clerk.com
# ─────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# ─────────────────────────────────────────────────────────────────
# STRIPE PAYMENTS
# https://dashboard.stripe.com
# ─────────────────────────────────────────────────────────────────
STRIPE_API_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ─────────────────────────────────────────────────────────────────
# CLOUDFLARE IMAGE DELIVERY
# https://dash.cloudflare.com
# ─────────────────────────────────────────────────────────────────
CLOUDFLARE_IMAGES_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_CDN_URL=https://imagedelivery.net/your_hash_here/

# ─────────────────────────────────────────────────────────────────
# ENCRYPTION (AES-256)
# Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────
ENCRYPTION_ALGORITHM=aes-256-ctr
ENCRYPTION_KEY=your_32_byte_hex_key_here
ENCRYPTION_SALT=your_salt_here
ENCRYPTION_IV=your_iv_here

# ─────────────────────────────────────────────────────────────────
# DISCORD NOTIFICATIONS (Optional)
# https://discord.com/developers/applications
# ─────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_here

# ─────────────────────────────────────────────────────────────────
# EUPAGO PAYMENTS (Optional)
# https://eupago.pt
# ─────────────────────────────────────────────────────────────────
EUPAGO_API_URL=https://sandbox.eupago.pt/api/v1.02/
EUPAGO_API_KEY=your_eupago_key_here
EUPAGO_ACCOUNT_ID=your_account_id_here
