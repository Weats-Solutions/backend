model Establishment {
  // ─── Identificação ─────────────────────────────────────────────────────────
  id       String              @id @default(ulid())
  name     String
  slug     String              @unique
  type     EstablishmentType
  status   EstablishmentStatus @default(ACTIVE)
  isOnline Boolean             @default(false)

  // ─── Contactos & Localização ────────────────────────────────────────────────
  email       String
  countryCode String //Calling code
  phoneNumber String
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String? //NOT ISO country name

  // ─── Detalhes & Faturação ──────────────────────────────────────────────────
  billingName    String
  billingTaxId   String
  billingAddress String?
  billingCity    String?
  billingState   String?
  billingZipCode String?
  billingCountry String? //ISO

  stripeCustomerId String @unique

  // ─── Social Media ──────────────────────────────────────────────────────────
  instagramUrl    String?
  tiktokUrl       String?
  facebookUrl     String?
  googleReviewUrl String?
  tripAdvisorUrl  String?
  websiteUrl      String?

  // ─── Configurações de Módulos ──────────────────────────────────────────────
  myPageModule       Boolean @default(false)
  menusModule        Boolean @default(false)
  callStaffModule    Boolean @default(false)
  takeAwayModule     Boolean @default(false)
  reservationsModule Boolean @default(false)

  // ─── Configurações ─────────────────────────────────────────────────────────
  primaryLanguage    EstablishmentLanguage   @default(PT)
  availableLanguages EstablishmentLanguage[] @default([PT])
  currency           Currency                @default(EUR)
  timezone           String                  @default("Europe/Lisbon")

  wifiSsid          String?
  wifiPassword      String?
  googleAnalyticsId String?

  // ─── Branding & Visuals ────────────────────────────────────────────────────
  logoImageId   String?
  bannerImageId String?
  activeThemeId String?

  // ─── Schedule ───────────────────────────────────────────────────────────────
  scheduleId String?   @unique
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  // ─── Branding & SEO ────────────────────────────────────────────────────────
  metadata EstablishmentMetadata?
  favicons FaviconAsset[]

  // ─── Sistema ───────────────────────────────────────────────────────────────
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String

  // ─── Relações: Core ────────────────────────────────────────────────────────
  owner       User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  activeTheme Theme? @relation("ActiveTheme", fields: [activeThemeId], references: [id])
  logoImage   Image? @relation("LogoImage", fields: [logoImageId], references: [id])
  bannerImage Image? @relation("BannerImage", fields: [bannerImageId], references: [id])

  // ─── Relações: Módulos & Features ──────────────────────────────────────────
  expenses       Expense[]
  images         Image[]
  themes         Theme[]
  employees      Employee[]
  serviceZones   ServiceZone[]
  qrCodes        QrCode[]
  menus          Menu[]
  Item           Item[]
  addons         Addon[]
  variantOptions VariantOption[]

  // ─── Relações: Reservas & Horários ─────────────────────────────────────────
  bookings                     Booking[]
  bookingRules                 BookingRules?
  establishmentBookingSettings EstablishmentBookingSettings?
  establishmentAvailabilities  EstablishmentAvailability[]

  // ─── Relações: Integrações & Pagamentos ────────────────────────────────────
  integrations  EstablishmentIntegrations?
  subscription  Subscription?
  invoices      Invoice[]
  devices       Device[]
  vivaTerminals VivaTerminal[]
  sumupReaders  SumupReader[]

  // ─── Relações: Marketing & Logs ────────────────────────────────────────────
  emailLogs   EmailLog[]
  auditLogs   AuditLog[]
  discounts   Discount[]
  promotions  Promotion[]

  // ─── Stock Management ──────────────────────────────────────────────────────
  suppliers            Supplier[]
  stockCategories      StockCategory[]
  stockItems           StockItem[]
  stockEntries         StockEntry[]
  stockExits           StockExit[]
  stockMovements       StockMovement[]
  stockAlerts          StockAlert[]
  stockInventoryCounts StockInventoryCount[]
  stockWarehouses      StockWarehouse[]

  @@index([name])
  @@index([ownerId])
  @@index([scheduleId])
}

enum Currency {
  EUR
  USD
  GBP
  JPY
  CHF
  AED
  CNY
}

model EstablishmentBookingSettings {
  id                String        @id @default(ulid())
  enabled           Boolean       @default(false)
  themeName         String        @default("default")
  themeMode         String        @default("light")
  establishmentId   String        @unique
  createdAt         DateTime      @default(now())
  notificationEmail String?
  notificationPhone String?
  primaryColor      String        @default("#f97316")
  updatedAt         DateTime      @updatedAt
  establishment     Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
}

model EstablishmentMetadata {
  id String @id @default(ulid())

  // SEO & Web Presence
  title       String? // Título
  shortName   String?
  description String?

  // Imagem de partilha (Open Graph)
  ogImageId String? @unique
  ogImage   Image?  @relation("OGImage", fields: [ogImageId], references: [id])

  establishmentId String        @unique
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

model FaviconAsset {
  id              String @id @default(ulid())
  establishmentId String
  imageId         String @unique // Um asset de favicon aponta para uma imagem única
  role            String // Ex: 'favicon-32x32.png'

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  image         Image         @relation("FaviconAsset", fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, role]) // Um asset de favicon aponta para uma imagem única
  @@index([establishmentId])
}
