<!DOCTYPE html
    PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html dir="ltr" lang="pt">

<head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <style>
        /* Estilos gerais */
        strong {
            color: #2B7FFF;
        }

        /* Ajustes para Mobile */
        @media only screen and (max-width: 600px) {
            .main-table {
                width: 100% !important;
                padding: 20px 15px !important;
            }

            .header-title {
                font-size: 22px !important;
            }

            .stats-box {
                padding: 20px !important;
            }

            .stats-number {
                font-size: 28px !important;
            }

            .responsive-text {
                font-size: 15px !important;
            }
        }
    </style>
</head>

<body
    style='background-color:#ffffff; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; margin:0; padding:0; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;'>
    <table align="center" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
        style="background-color:#ffffff;">
        <tr>
            <td align="center">
                <!-- Wrapper do Email -->
                <table class="main-table" align="center" width="100%" border="0" cellpadding="0" cellspacing="0"
                    role="presentation" style="max-width:560px; margin:0 auto; padding:40px 0 48px;">
                    <tbody>
                        <tr>
                            <td>
                                <!-- Logo -->
                                <img alt="{{saasName}}"
                                    src="https://pub-91723ae32b5f4bc88cd11d3b390c75ba.r2.dev/Weats%20icon%20Files-01.svg"
                                    style="display:block; outline:none; border:none; text-decoration:none; border-radius:1.2rem; width:85px; height:85px" />

                                <!-- Título -->
                                <h1 class="header-title"
                                    style="font-size:24px; letter-spacing:-0.5px; line-height:1.3; font-weight:600; color:rgb(72,72,72); padding-top:24px; margin:0;">
                                    QR Codes Partilhados 📦
                                </h1>

                                <!-- Corpo de Texto -->
                                <p class="responsive-text"
                                    style="font-size:16px; line-height:1.6; margin:20px 0; color:#3c4149;">
                                    Olá,<br /><br />
                                    <strong>{{senderName}}</strong> partilhou consigo os identificadores QR do
                                    estabelecimento <strong>{{establishmentName}}</strong>.<br /><br />
                                    Estes QR Codes foram gerados para otimizar o atendimento no espaço, garantindo uma
                                    ligação direta entre o cliente e o respetivo ponto de serviço.
                                </p>

                                <!-- Card de Estatísticas -->
                                <table width="100%" border="0" cellpadding="0" cellspacing="0"
                                    style="background-color:#f8fafc; border-radius:10px; margin:24px 0; border: 1px solid #e2e8f0;">
                                    <tr>
                                        <td class="stats-box" style="padding:24px; text-align:center;">
                                            <p
                                                style="margin:0 0 8px 0; font-size:12px; color:#64748b; text-transform:uppercase; letter-spacing:1px; font-weight:600;">
                                                Total de QR Codes Partilhados</p>
                                            <h2 class="stats-number"
                                                style="margin:0; font-size:32px; color:#2B7FFF; font-weight:700;">
                                                {{qrCodesCount}}</h2>
                                            <p
                                                style="margin:8px 0 0 0; font-size:14px; color:#475569; word-break: break-word;">
                                                Arquivo:
                                                <strong>{{establishmentName}}.zip</strong>
                                            </p>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Zonas de Serviço -->
                                <div style="margin-bottom:32px;">
                                    <h3
                                        style="font-size:15px; color:#1e293b; border-bottom:1px solid #eaeaea; padding-bottom:10px; margin-bottom:15px;">
                                        Distribuição por Zona de Serviço</h3>
                                    <table width="100%" cellpadding="0" cellspacing="0"
                                        style="font-size:15px; color:#475569; line-height:1.6;">
                                        {{#each serviceZones}}
                                        <tr>
                                            <td style="padding:8px 0;">📍 {{this.zoneName}}</td>
                                            <td align="right" style="padding:8px 0;"><strong>{{this.count}}
                                                    unid.</strong></td>
                                        </tr>
                                        {{/each}}
                                        <tr>
                                            <td colspan="2"
                                                style="padding-top:15px; font-size:13px; line-height:1.5; color:#64748b; border-top:1px solid #f1f5f9;">
                                                <br />
                                                <strong>Nota Técnica:</strong> Os ficheiros estão em alta resolução.
                                                Recomendamos a impressão em suportes sem brilho para evitar reflexos na
                                                leitura ótica.
                                            </td>
                                        </tr>
                                    </table>
                                </div>

                                <p style="font-size:14px; line-height:1.6; margin:0 0 20px; color:#64748b;">
                                    Os QR Codes encontram-se anexados a este email. Caso necessite de apoio técnico,
                                    contacte a equipa responsável pelo envio.
                                </p>

                                <hr style="width:100%; border:none; border-top:1px solid #eaeaea; margin:32px 0 24px" />

                                <!-- Rodapé -->
                                <table width="100%" border="0" cellpadding="0" cellspacing="0">
                                    <tr>
                                        <td style="color:#b4becc; font-size:13px; line-height:1.5;">
                                            <strong>{{saasName}} Solutions</strong><br />
                                            Departamento de Apoio ao Cliente e Operações.<br />
                                            <a href="https://dash.weats.app"
                                                style="color:#2B7FFF; text-decoration:none;"
                                                target="_blank">Documentação e Suporte</a>
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>