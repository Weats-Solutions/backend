model AuditLog {
  id              String        @id @default(cuid())
  establishmentId String
  actorId         String?
  actorName       String?
  actorType       ActorType
  action          LogAction
  resource        String
  resourceId      String?
  changes         Json?
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime      @default(now())
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, createdAt])
  @@index([actorId])
  @@index([action])
  @@index([resource])
  @@map("audit_logs")
}

enum ActorType {
  USER
  EMPLOYEE
  SYSTEM
  GUEST
  OWNER
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
}

model BookingRules {
  id                  String        @id @default(ulid())
  minDaysInAdvance    Int           @default(0)
  maxDaysInAdvance    Int           @default(90)
  minGuestsPerBooking Int           @default(1)
  maxGuestsPerBooking Int           @default(10)
  defaultDuration     Int           @default(120)
  autoConfirm         Boolean       @default(true)
  allowCancellation   Boolean       @default(true)
  cancellationHours   Int           @default(24)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  establishmentId     String        @unique
  establishment       Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
}

model EstablishmentAvailability {
  id              String                 @id @default(ulid())
  availableDate   DateTime               @db.Date
  isClosed        Boolean                @default(false)
  closureReason   String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  establishmentId String
  timeSlots       AvailabilityTimeSlot[]
  establishment   Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, availableDate])
  @@index([establishmentId])
  @@index([availableDate])
}

model AvailabilityTimeSlot {
  id             String                    @id @default(ulid())
  slot           String
  maxBookings    Int                       @default(10)
  isActive       Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  availabilityId String
  availability   EstablishmentAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  bookings       Booking[]

  @@unique([availabilityId, slot])
  @@index([availabilityId])
}

model Booking {
  id                 String               @id @default(ulid())
  bookingDate        DateTime             @db.Date
  bookingTime        String
  numberOfGuests     Int
  customerName       String
  customerEmail      String
  customerPhone      String?
  specialRequests    String?
  status             BookingStatus        @default(PENDING)
  confirmationCode   String               @unique @default(ulid())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  cancelledAt        DateTime?
  cancellationReason String?
  userId             String?
  establishmentId    String
  timeSlotId         String
  internalNotes      String?
  source             BookingSource        @default(ONLINE)
  establishment      Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  timeSlot           AvailabilityTimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  user               User?                @relation(fields: [userId], references: [id])
  logs               BookingLog[]

  @@index([userId])
  @@index([establishmentId])
  @@index([bookingDate])
  @@index([status])
  @@index([confirmationCode])
  @@index([customerEmail])
}

model BookingLog {
  id          String           @id @default(ulid())
  bookingId   String
  event       BookingEventType
  actorId     String?
  actorName   String?
  actorType   ActorType
  description String
  metadata    Json?
  createdAt   DateTime         @default(now())
  booking     Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([bookingId, event])
  @@map("booking_logs")
}

enum BookingEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  EMAIL_SENT
  CANCELLED
  CONFIRMED
  COMPLETED
  NO_SHOW
  NOTE_UPDATED
  DELETED
}

enum BookingSource {
  ONLINE
  PHONE
  WALK_IN
  STAFF
}

/// =======================================================
/// DISCOUNTS (Redução direta de preço)
/// =======================================================
model Discount {
  id              String       @id @default(ulid())
  establishmentId String
  scheduleId      String?      @unique
  name            String
  description     String?
  type            DiscountType
  value           Decimal      @db.Decimal(10, 2)
  isActive        Boolean      @default(true)
  stackable       Boolean      @default(false)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  establishment Establishment    @relation(fields: [establishmentId], references: [id])
  schedule      Schedule?        @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  targets       DiscountTarget[]

  @@index([establishmentId, isActive])
  @@index([scheduleId])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model DiscountTarget {
  id            String  @id @default(ulid())
  discountId    String
  itemId        String?
  posCategoryId String?

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  item     Item?    @relation(fields: [itemId], references: [id])

  @@index([discountId])
}

/// =======================================================
/// PROMOTIONS (Regras condicionais, ex: Buy X Get Y)
/// =======================================================
model Promotion {
  id              String        @id @default(ulid())
  establishmentId String
  scheduleId      String?       @unique
  name            String
  description     String?
  type            PromotionType
  isActive        Boolean       @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id])
  schedule      Schedule?     @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  buyXGetYRule  BuyXGetYRule?

  @@index([establishmentId, isActive])
  @@index([scheduleId])
}

enum PromotionType {
  BUY_X_GET_Y
  // futuro: SPEND_X_GET_Y, BUNDLE, FREE_DELIVERY
}

/// Regras de Buy X Get Y (aplicado ao nível de Item)
model BuyXGetYRule {
  id          String @id @default(ulid())
  promotionId String @unique

  requiredItemId   String
  requiredQuantity Int

  rewardItemId   String
  rewardQuantity Int
  applyCheapest  Boolean @default(true) // aplica reward no item de menor valor

  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  requiredItem Item      @relation("RequiredItem", fields: [requiredItemId], references: [id])
  rewardItem   Item      @relation("RewardItem", fields: [rewardItemId], references: [id])
}

model EmailLog {
  id                 String        @id
  establishmentId    String
  userId             String?
  to                 String
  template           EmailTemplate
  type               EmailLogType  @default(TRANSACTIONAL)
  lang               String        @db.VarChar(5)
  subject            String
  status             EmailStatus   @default(QUEUED)
  provider           EmailProvider @default(ZEPTO)
  providerMessageId  String?       @unique
  providerStatusCode Int?
  providerMessage    String?
  attempts           Int           @default(0)
  context            Json?
  hasAttachments     Boolean       @default(false)
  attachmentsCount   Int           @default(0)
  queuedAt           DateTime      @default(now())
  sentAt             DateTime?
  deliveredAt        DateTime?
  openedAt           DateTime?
  clickedAt          DateTime?
  bouncedAt          DateTime?
  complainedAt       DateTime?
  failedAt           DateTime?
  metadata           Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime
  emailEvents        EmailEvent[]
  Establishment      Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, type, createdAt, status])
  @@index([establishmentId, createdAt])
  @@index([establishmentId, status])
  @@index([establishmentId, template])
  @@index([providerMessageId])
  @@index([status, createdAt])
  @@index([template, type])
  @@index([to])
  @@index([userId])
  @@index([createdAt])
}

model EmailEvent {
  id         String         @id @default(ulid())
  emailLogId String
  event      EmailEventType
  occurredAt DateTime       @default(now())
  /// Payload bruto do webhook para debugging
  payload    Json?
  emailLog   EmailLog       @relation(fields: [emailLogId], references: [id], onDelete: Cascade)

  @@index([emailLogId])
  @@index([emailLogId, event])
  @@index([occurredAt])
}

