model OrderItem {
  id              String   @id @default(ulid())
  orderId         String
  itemId          String
  itemVariantId   String? // se aplicável
  quantity        Int
  basePrice       Decimal  @db.Decimal(10, 2) // preço unitário sem promoções
  modifierTotal   Decimal  @db.Decimal(10, 2) // total de modificadores
  subtotal        Decimal  @db.Decimal(10, 2) // basePrice * quantity + modifiers
  discountAmount  Decimal  @db.Decimal(10, 2) // desconto aplicado neste item
  promotionAmount Decimal  @db.Decimal(10, 2) // recompensa/promo aplicada
  finalPrice      Decimal  @db.Decimal(10, 2) // subtotal - discountAmount - promotionAmount
  promotionId     String? // referência a promoção aplicada
  discountId      String? // referência a desconto aplicado
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

