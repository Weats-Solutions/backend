{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@weats/bull": [
        "libs/bull/src"
      ],
      "@weats/bull/*": [
        "libs/bull/src/*"
      ],
      "@weats/common": [
        "libs/common/src"
      ],
      "@weats/common/*": [
        "libs/common/src/*"
      ],
      "@weats/configs": [
        "libs/configs/src"
      ],
      "@weats/configs/*": [
        "libs/configs/src/*"
      ],
      "@weats/contracts": [
        "libs/contracts/src"
      ],
      "@weats/contracts/*": [
        "libs/contracts/src/*"
      ],
      "@weats/database": [
        "libs/database/src"
      ],
      "@weats/database/*": [
        "libs/database/src/*"
      ],
      "@weats/encryption": [
        "libs/encryption/src"
      ],
      "@weats/encryption/*": [
        "libs/encryption/src/*"
      ],
      "@weats/integrations": [
        "libs/integrations/src"
      ],
      "@weats/integrations/*": [
        "libs/integrations/src/*"
      ],
      "@weats/item-core": [
        "libs/item-core/src"
      ],
      "@weats/item-core/*": [
        "libs/item-core/src/*"
      ],
      "@weats/translate": [
        "libs/translate/src"
      ],
      "@weats/translate/*": [
        "libs/translate/src/*"
      ],
      "@weats/types": [
        "libs/types/src"
      ],
      "@weats/types/*": [
        "libs/types/src/*"
      ]
    },
    "composite": false
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}