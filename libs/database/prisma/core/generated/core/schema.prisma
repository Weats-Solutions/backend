model Establishment {
  id                           String                        @id @default(ulid())
  name                         String
  slug                         String                        @unique
  type                         EstablishmentType
  isOnline                     Boolean                       @default(false)
  ownerId                      String
  stripeCustomerId             String                        @unique
  status                       EstablishmentStatus           @default(ACTIVE)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  activeThemeId                String?
  addons                       Addon[]
  bookings                     Booking[]
  bookingRules                 BookingRules?
  employees                    Employee[]
  activeTheme                  Theme?                        @relation("ActiveTheme", fields: [activeThemeId], references: [id])
  owner                        User                          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  establishmentAvailabilities  EstablishmentAvailability[]
  establishmentBookingSettings EstablishmentBookingSettings?
  establishmentBrand           EstablishmentBrand?
  establishmentDetails         EstablishmentDetails?
  establishmentSchedule        EstablishmentSchedule[]
  establishmentSettings        EstablishmentSettings?
  establishmentSocialMedia     EstablishmentSocialMedia?
  homePage                     HomePage?
  images                       Image[]
  invoices                     Invoice[]
  Item                         Item[]
  landingPage                  LandingPage?
  menus                        Menu[]
  serviceZones                 ServiceZone[]
  subscription                 Subscription?
  themes                       Theme[]
  variantOptions               VariantOption[]
  auditLogs                    AuditLog[]
  devices                      Device[]

  @@index([name])
  @@index([ownerId])
}

model EstablishmentSchedule {
  id              String        @id @default(ulid())
  establishmentId String
  scheduleId      String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  schedule        Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

model EstablishmentDetails {
  id              String        @id @default(ulid())
  email           String
  address         String?
  city            String?
  state           String?
  zipCode         String?
  country         String?
  countryCode     String?
  phoneNumber     String?
  cuisine         String?
  billingName     String?
  billingTaxId    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  establishmentId String        @unique
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
}

model EstablishmentSocialMedia {
  id              String        @id @default(ulid())
  instagramUrl    String?
  tiktokUrl       String?
  facebookUrl     String?
  googleReviewUrl String?
  tripAdvisorUrl  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  establishmentId String        @unique
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
}

model EstablishmentBookingSettings {
  id              String        @id @default(ulid())
  enabled         Boolean       @default(false)
  themeName       String        @default("default")
  themeMode       String        @default("light")
  establishmentId String        @unique
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
}

model EstablishmentSettings {
  id                 String                  @id @default(ulid())
  primaryLanguage    EstablishmentLanguage   @default(PT)
  availableLanguages EstablishmentLanguage[] @default([PT])
  timezone           String                  @default("Europe/Lisbon")
  onlyMenu           Boolean                 @default(false)
  needSession        Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  establishmentId    String                  @unique
  establishment      Establishment           @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
}

model EstablishmentBrand {
  id              String        @id @default(ulid())
  logoImageId     String?
  bannerImageId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  establishmentId String        @unique
  bannerImage     Image?        @relation("BannerImage", fields: [bannerImageId], references: [id])
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  logoImage       Image?        @relation("LogoImage", fields: [logoImageId], references: [id])
}

model HomePage {
  id                   String                @id @default(ulid())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  establishmentId      String                @unique
  establishment        Establishment         @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  homePageConfig       HomePageConfig?
  homePageTranslations HomePageTranslation[]
}

model HomePageConfig {
  id                      String    @id @default(ulid())
  logo                    String?
  shortName               String
  primaryColor            String
  secondaryColor          String
  banner                  String?
  backgroundSize          String
  highlightPrimaryColor   String
  highlightSecondaryColor String
  highlightIconColor      String
  highlightBackground     String
  location                String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  homePageId              String?   @unique
  bannerImage             Image?    @relation("BannerHomePageImage", fields: [banner], references: [id])
  homePage                HomePage? @relation(fields: [homePageId], references: [id], onDelete: Cascade)
  logoImage               Image?    @relation("LogoHomePageImage", fields: [logo], references: [id])
}

model HomePageTranslation {
  id          String   @id @default(ulid())
  locale      String
  title       String
  description String
  homePageId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  homePage    HomePage @relation(fields: [homePageId], references: [id], onDelete: Cascade)
}

model Image {
  id                  String               @id @default(ulid())
  cloudflareImageId   String               @unique
  fileName            String
  url                 String
  fileSize            Float
  metadata            Json?
  establishmentId     String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bannerUsedInBrands  EstablishmentBrand[] @relation("BannerImage")
  logoUsedInBrands    EstablishmentBrand[] @relation("LogoImage")
  bannerUsedInConfigs HomePageConfig[]     @relation("BannerHomePageImage")
  logoUsedInConfigs   HomePageConfig[]     @relation("LogoHomePageImage")
  establishment       Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  item                Item[]               @relation("ImageItem")
  menuCategory        MenuCategory[]       @relation("ImageMenuCategory")

  @@index([establishmentId])
}

// ==========================================
// 1. O NÚCLEO (ITEM)
// ==========================================

model Item {
  id              String  @id @default(ulid())
  // O nome aqui serve como "Nome Interno" (para o staff/POS na língua principal)
  name            String
  description     String? // Descrição interna
  imageId         String?
  establishmentId String
  posCategoryId   String?

  // Relações
  variants       ItemVariant[]
  modifierGroups ItemModifierGroup[]

  // TRADUÇÕES DO ITEM (Nome e Descrição para o Menu)
  translations ItemTranslation[]
  Image        Image?            @relation("ImageItem", fields: [imageId], references: [id])

  posCategory              POSCategory?         @relation(fields: [posCategoryId], references: [id])
  establishment            Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  modifierOptionsAsProduct ItemModifierOption[] @relation("ProductAsModifier")
  menuItemPositions        MenuItemPosition[]
}

model ItemTranslation {
  id     String @id @default(ulid())
  itemId String
  locale String // "en", "fr", "es"

  name        String // O que aparece no menu QR
  description String?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, locale]) // Garante 1 tradução por língua por item
}

// ==========================================
// 2. VARIANTES (Tamanhos, Pontos, Tipos)
// ==========================================

model ItemVariant {
  id              String  @id @default(ulid())
  itemId          String
  variantOptionId String
  price           Float // Preço Base
  isDefault       Boolean @default(false)

  item   Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  option VariantOption @relation(fields: [variantOptionId], references: [id])

  @@unique([itemId, variantOptionId])
}

model VariantOption {
  id              String      @id @default(ulid())
  name            String
  code            String?     @unique
  type            VariantType @default(SIZE)
  establishmentId String?
  quantity        Float? // Para guardar "20", "33", "1"
  unit            String? // Para guardar "CL", "L", "KG"

  variants ItemVariant[]
  isGlobal Boolean       @default(false)

  translations  VariantOptionTranslation[]
  establishment Establishment?             @relation(fields: [establishmentId], references: [id])
}

enum VariantType {
  SIZE // Frontend desenha: Selector de Tamanho (Copo, Litros)
  PREPARATION // Frontend desenha: Lista de Ponto de Carne
  FLAVOR // Frontend desenha: Bolinhas de cor ou lista de sabores
  COLOR // Frontend desenha: Selector de cor
  OTHER
}

model VariantOptionTranslation {
  id              String @id @default(ulid())
  variantOptionId String
  locale          String
  name            String // ex: "Well Done", "Bien Cuit"

  variantOption VariantOption @relation(fields: [variantOptionId], references: [id], onDelete: Cascade)

  @@unique([variantOptionId, locale])
}

// ==========================================
// 3. MODIFICADORES E GRUPOS (Acompanhamentos)
// ==========================================

enum ModifierDisplayMode {
  RADIO // Para escolha única obrigatória (Ponto da Carne)
  CHECKBOX // Para lista de Sim/Não (Pizza Toppings, Remover Ingredientes)
  QUANTITY // Para incrementos (Extras do Burger)
}

model ItemModifierGroup {
  id     String @id @default(ulid())
  itemId String

  name String // Nome Interno (ex: "Escolha o Molho")
  code String? // ex: "SAUCE_CHOICE"

  displayMode  ModifierDisplayMode @default(RADIO)
  minSelection Int                 @default(0)
  maxSelection Int?
  position     Int                 @default(0)

  item    Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
  options ItemModifierOption[]

  // TRADUÇÕES DO TÍTULO DO GRUPO (Importante!)
  translations ItemModifierGroupTranslation[]
}

model ItemModifierGroupTranslation {
  id              String @id @default(ulid())
  modifierGroupId String
  locale          String
  name            String // ex: "Choose your Sauce", "Choisissez votre sauce"

  modifierGroup ItemModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([modifierGroupId, locale])
}

model ItemModifierOption {
  id              String @id @default(ulid())
  modifierGroupId String

  // Configurações de Venda neste contexto
  price    Float? // Se null, usa o preço original do item. Se definido (ex: 0), sobrepõe.
  position Int    @default(0)

  // Quantidade permitida para esta opção específica
  minQuantity     Int @default(0) // Mínimo que pode selecionar (normalmente 0)
  maxQuantity     Int @default(1) // Máximo que pode selecionar (1 = radio, >1 = counter)
  defaultQuantity Int @default(0) // Quantidade pré-selecionada (ex: 2 fatias incluídas, extras custam mais)

  // --- A MUDANÇA ESTÁ AQUI (Campos Opcionais) ---

  // CASO 1: É uma instrução ou ingrediente simples (ex: "Sem Cebola")
  addonId String?
  addon   Addon?  @relation(fields: [addonId], references: [id])

  // CASO 2: É um Item real que já existe (ex: "Batata Frita", "Coca-Cola")
  productId String?
  product   Item?   @relation("ProductAsModifier", fields: [productId], references: [id])

  group ItemModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  // Regra de Validação (Database constraint se possível, ou lógica de app): 
  // Tem de ter OU addonId OU productId, nunca os dois.
  @@index([modifierGroupId])
  @@index([productId])
  @@index([addonId])
}

// ==========================================
// 4. BIBLIOTECA DE EXTRAS (ADDONS)
// ==========================================

model Addon {
  id              String               @id @default(ulid())
  name            String // Nome Interno (ex: "Batata Frita")
  establishmentId String?
  modifierOptions ItemModifierOption[]
  isGlobal        Boolean              @default(false)

  // TRADUÇÕES DOS EXTRAS
  translations  AddonTranslation[]
  establishment Establishment?     @relation(fields: [establishmentId], references: [id])
}

model AddonTranslation {
  id      String @id @default(ulid())
  addonId String
  locale  String
  name    String // ex: "French Fries", "Frites"

  addon Addon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([addonId, locale])
}

model LandingPage {
  id                      String                   @id @default(ulid())
  shortName               String
  themeId                 String?
  establishmentId         String                   @unique
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  establishment           Establishment            @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  theme                   Theme?                   @relation(fields: [themeId], references: [id])
  landingPageTranslations LandingPageTranslation[]
}

model LandingPageTranslation {
  id            String      @id @default(ulid())
  locale        String
  title         String
  description   String
  landingPageId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  landingPage   LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
}

model Menu {
  id               String            @id @default(ulid())
  position         Int               @default(0)
  isVisible        Boolean           @default(false)
  isHighlighted    Boolean           @default(false)
  color            String?
  type             MenuType          @default(DEFAULT)
  price            Float?
  maxItemsPerOrder Int?
  establishmentId  String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  establishment    Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  categories       MenuCategory[]
  menuSchedule     MenuSchedule[]
  translations     MenuTranslation[]

  @@index([establishmentId])
  @@index([establishmentId, position])
}

model MenuSchedule {
  id         String   @id @default(ulid())
  menuId     String
  scheduleId String
  menu       Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
}

model MenuTranslation {
  id           String   @id @default(ulid())
  locale       String
  name         String
  description  String?
  observations String?
  menuId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  menu         Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, locale])
  @@index([menuId])
}

model MenuCategory {
  id            String                    @id @default(ulid())
  isVisible     Boolean                   @default(true)
  imageId       String?
  menuId        String
  position      Int                       @default(0)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  image         Image?                    @relation("ImageMenuCategory", fields: [imageId], references: [id])
  menu          Menu                      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  translations  MenuCategoryTranslation[]
  subcategories MenuSubcategory[]

  @@index([menuId])
  @@index([menuId, position])
}

model MenuCategoryTranslation {
  id         String       @id @default(ulid())
  locale     String
  name       String
  categoryId String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model MenuSubcategory {
  id           String                       @id @default(ulid())
  isVisible    Boolean                      @default(true)
  categoryId   String?
  position     Int                          @default(0)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  items        MenuItemPosition[]
  category     MenuCategory?                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations MenuSubcategoryTranslation[]

  @@index([categoryId])
  @@index([categoryId, position])
}

model MenuSubcategoryTranslation {
  id            String          @id @default(ulid())
  locale        String
  name          String
  description   String?
  subcategoryId String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  subcategory   MenuSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([subcategoryId, locale])
}

model MenuItemPosition {
  id            String          @id @default(ulid())
  itemId        String
  subcategoryId String
  position      Int             @default(0)
  isIncluded    Boolean         @default(false)
  isVisible     Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  item          Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  subcategory   MenuSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([itemId, subcategoryId])
  @@index([itemId])
  @@index([subcategoryId])
  @@index([subcategoryId, position])
}

enum MenuType {
  DEFAULT
  RODIZIO
}

model MoloniToken {
  id               String   @id @default(cuid())
  accessToken      String
  refreshToken     String
  expiresAt        DateTime
  refreshExpiresAt DateTime
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
  establishmentId  String?  @unique

  @@map("moloni_tokens")
}

model POSCategory {
  id              String @id @default(ulid())
  name            String
  establishmentId String
  items           Item[]
}

model Device {
  id              String        @id @default(ulid())
  name            String?
  pairingKey      String?       @unique
  deviceToken     String?       @unique
  isActive        Boolean       @default(false)
  lastSeen        DateTime?
  establishmentId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  printers        Printer[]

  @@map("devices")
}

model Printer {
  id           String   @id @default(ulid())
  name         String
  friendlyName String?
  isDefault    Boolean  @default(false)
  isEnabled    Boolean  @default(true)
  deviceId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, name])
  @@map("printers")
}

model Schedule {
  id                    String                  @id @default(ulid())
  openTime              String
  closeTime             String
  dayOfWeek             DayOfWeek
  type                  ScheduleType
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  establishmentSchedule EstablishmentSchedule[]
  menuSchedule          MenuSchedule[]
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/core"
}

datasource db {
  provider = "postgresql"
}

model Subscription {
  id                   String             @id @default(ulid())
  establishmentId      String             @unique
  stripeSubscriptionId String             @unique
  planCycleId          String
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean
  cancelAt             DateTime?
  canceledAt           DateTime?
  stripeCustomerId     String             @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  establishment        Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  planCycle            PlanCycle          @relation(fields: [planCycleId], references: [id])

  @@index([stripeCustomerId])
  @@index([establishmentId])
  @@index([status])
  @@index([stripeCustomerId, status])
}

model Plan {
  id         String        @id @default(ulid())
  name       String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  planCycles PlanCycle[]
  features   PlanFeature[]
}

model PlanCycle {
  id           String         @id @default(ulid())
  planId       String
  cycle        BillingCycle
  price        Decimal        @db.Decimal(10, 2)
  priceId      String         @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  plan         Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  Subscription Subscription[]

  @@unique([planId, cycle])
}

model Feature {
  id           String        @id @default(ulid())
  name         String        @unique
  type         FeatureType
  planFeatures PlanFeature[]
}

model PlanFeature {
  id            String   @id @default(ulid())
  planId        String
  featureId     String
  valueBoolean  Boolean?
  valueQuantity Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  feature       Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  plan          Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@index([featureId])
}

model Invoice {
  id              String        @id @default(ulid())
  customerId      String
  establishmentId String
  stripeInvoiceId String
  subscriptionId  String
  amountPaid      Int
  status          String
  createdAt       DateTime      @default(now())
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
}

model Theme {
  id                   String          @id @default(cuid())
  name                 String
  config               Json
  isDefault            Boolean         @default(false)
  establishmentId      String?
  activeEstablishments Establishment[] @relation("ActiveTheme")
  landingPages         LandingPage[]
  establishment        Establishment?  @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
}

model User {
  id             String          @id @default(ulid())
  clerkUserId    String          @unique
  email          String          @unique
  firstName      String
  lastName       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bookings       Booking[]
  establishments Establishment[]
}

model WebhookEvent {
  id          String   @id @default(ulid())
  provider    String
  eventId     String
  eventType   String
  status      String
  processedAt DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider])
  @@index([status])
  @@index([expiresAt])
}

model ServiceZone {
  id              String         @id @default(ulid())
  name            String
  isActive        Boolean        @default(true)
  position        Int            @default(0)
  establishmentId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  servicePoints   ServicePoint[]
  establishment   Establishment  @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
}

model ServicePoint {
  id           String           @id @default(ulid())
  name         String
  type         ServicePointType @default(TABLE)
  maxCapacity  Int              @default(4)
  minCapacity  Int              @default(1)
  isReservable Boolean          @default(true)
  isPriority   Boolean          @default(false)
  isActive     Boolean          @default(true)
  token        String?          @unique @default(ulid())
  zoneId       String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  color        String           @default("gray")
  height       Float            @default(1)
  rotation     Float            @default(0)
  shape        String           @default("rectangle")
  width        Float            @default(1)
  x            Float            @default(0)
  y            Float            @default(0)
  z            Float            @default(0)
  zone         ServiceZone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
}
