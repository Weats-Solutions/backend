model Establishment {
  // ─── Identificação ─────────────────────────────────────────────────────────
  id       String              @id @default(ulid())
  name     String
  slug     String              @unique
  type     EstablishmentType
  status   EstablishmentStatus @default(ACTIVE)
  isOnline Boolean             @default(false)

  // ─── Contactos & Localização ────────────────────────────────────────────────
  email       String
  countryCode String
  phoneNumber String
  address     String
  city        String
  state       String
  zipCode     String
  country     String

  // ─── Detalhes & Faturação ──────────────────────────────────────────────────
  billingName      String
  billingTaxId     String
  stripeCustomerId String @unique

  // ─── Social Media ──────────────────────────────────────────────────────────
  instagramUrl    String?
  tiktokUrl       String?
  facebookUrl     String?
  googleReviewUrl String?
  tripAdvisorUrl  String?
  websiteUrl      String?

  // ─── Configurações ─────────────────────────────────────────────────────────
  primaryLanguage    EstablishmentLanguage   @default(PT)
  availableLanguages EstablishmentLanguage[] @default([PT])
  currency           Currency                @default(EUR)
  timezone           String                  @default("Europe/Lisbon")

  // ─── Branding & Visuals ────────────────────────────────────────────────────
  logoImageId   String?
  bannerImageId String?
  activeThemeId String?

  // ─── Schedule ───────────────────────────────────────────────────────────────
  scheduleId String?   @unique
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  // ─── Sistema ───────────────────────────────────────────────────────────────
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String

  // ─── Relações: Core ────────────────────────────────────────────────────────
  owner       User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  activeTheme Theme? @relation("ActiveTheme", fields: [activeThemeId], references: [id])
  logoImage   Image? @relation("LogoImage", fields: [logoImageId], references: [id])
  bannerImage Image? @relation("BannerImage", fields: [bannerImageId], references: [id])

  // ─── Relações: Módulos & Features ──────────────────────────────────────────
  expenses       Expense[]
  images         Image[]
  themes         Theme[]
  employees      Employee[]
  serviceZones   ServiceZone[]
  menus          Menu[]
  Item           Item[]
  addons         Addon[]
  variantOptions VariantOption[]

  // ─── Relações: Reservas & Horários ─────────────────────────────────────────
  bookings                     Booking[]
  bookingRules                 BookingRules?
  establishmentBookingSettings EstablishmentBookingSettings?
  establishmentAvailabilities  EstablishmentAvailability[]

  // ─── Relações: Integrações & Pagamentos ────────────────────────────────────
  integrations  EstablishmentIntegrations?
  subscription  Subscription?
  invoices      Invoice[]
  devices       Device[]
  vivaTerminals VivaTerminal[]
  sumupReaders  SumupReader[]

  // ─── Relações: Marketing & Logs ────────────────────────────────────────────
  landingPage LandingPage?
  emailLogs   EmailLog[]
  auditLogs   AuditLog[]
  discounts   Discount[]
  promotions  Promotion[]

  // ─── Stock Management ──────────────────────────────────────────────────────
  suppliers            Supplier[]
  stockCategories      StockCategory[]
  stockItems           StockItem[]
  stockEntries         StockEntry[]
  stockExits           StockExit[]
  stockMovements       StockMovement[]
  stockAlerts          StockAlert[]
  stockInventoryCounts StockInventoryCount[]
  stockWarehouses      StockWarehouse[]

  @@index([name])
  @@index([ownerId])
  @@index([scheduleId])
}

enum Currency {
  EUR
  USD
  GBP
}

model EstablishmentBookingSettings {
  id                String        @id @default(ulid())
  enabled           Boolean       @default(false)
  themeName         String        @default("default")
  themeMode         String        @default("light")
  establishmentId   String        @unique
  createdAt         DateTime      @default(now())
  notificationEmail String?
  notificationPhone String?
  primaryColor      String        @default("#f97316")
  updatedAt         DateTime      @updatedAt
  establishment     Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
}
