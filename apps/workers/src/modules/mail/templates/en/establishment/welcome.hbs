<!DOCTYPE html
    PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html dir="ltr" lang="en">

<head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta name="x-apple-disable-message-reformatting" />
</head>

<style>
    strong {
        color: #2B7FFF;
    }
</style>

<body style='background-color:#ffffff;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif'>
    <table align="center" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
        style="max-width:560px;margin:0 auto;padding:40px 0 48px">
        <tbody>
            <tr style="width:100%">
                <td>
                    <img alt="{{saasName}}"
                        src="https://pub-91723ae32b5f4bc88cd11d3b390c75ba.r2.dev/Weats%20icon%20Files-01.svg"
                        style="display:block; outline:none; border:none; text-decoration:none; border-radius:1.2rem; width:75px; height:75px; margin-bottom: 24px;" />

                    <h1
                        style="font-size:24px;letter-spacing:-0.5px;line-height:1.3;font-weight:400;color:#484848;margin:0 0 8px">
                        Welcome to {{saasName}} 👋
                    </h1>

                    <p style="font-size:17px;line-height:1.6;margin:0 0 20px;color:#3c4149;">
                        Hi, <strong>{{firstName}} {{lastName}}</strong>,<br /><br />
                        It is a great pleasure to welcome you to <strong>{{saasName}}</strong>!
                        We are thrilled to have you join our community.
                        <br /><br />
                        <strong>{{saasName}}</strong> is an innovative solution designed to modernize and simplify
                        management for restaurants, hotels, bars, cafes, and other businesses in the hospitality sector.
                        <br /><br />
                        With your registration complete, you can now start exploring the platform and discover how
                        <strong>{{saasName}}</strong> can help you improve your customers' experience and
                        optimize your internal processes.
                        <br /><br />
                        We are very excited to have you with us and ready to support you every step of the way.
                        <br /><br />
                        The <strong>{{saasName}}</strong> team
                    </p>

                    <table align="center" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                        style="padding:16px 0 32px">
                        <tbody>
                            <tr>
                                <td>
                                    <a href="{{redirectUrl}}"
                                        style="display:block;text-decoration:none;background-color:#2B7FFF;border-radius:10px;font-weight:600;color:#fff;font-size:15px;text-align:center;padding:16px 23px"
                                        target="_blank">
                                        Go to Dashboard
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <hr style="width:100%;border:none;border-top:1px solid #eaeaea;margin:8px 0 24px" />
                    <a href="https://dash.weats.app" style="color:#b4becc;text-decoration:none;font-size:14px"
                        target="_blank">{{saasName}}</a>
                </td>
            </tr>
        </tbody>
    </table>
</body>

</html>