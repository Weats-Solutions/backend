{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/gateway/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/gateway/test/jest-e2e.json",
    "prisma": "cross-env PRISMA_DB_TYPE=$db prisma",
    "prisma:gen": "pnpm prisma generate",
    "prisma:push": "pnpm prisma db push",
    "prisma:mig": "pnpm prisma migrate dev",
    "prisma:studio": "pnpm prisma studio",
    "prisma:core:gen": "cross-env PRISMA_DB_TYPE=core prisma generate",
    "prisma:core:push": "cross-env PRISMA_DB_TYPE=core prisma db push",
    "prisma:core:pull": "cross-env PRISMA_DB_TYPE=core prisma db pull",
    "prisma:core:mig": "cross-env PRISMA_DB_TYPE=core prisma migrate dev",
    "prisma:core:studio": "cross-env PRISMA_DB_TYPE=core prisma studio",
    "prisma:orders:gen": "cross-env PRISMA_DB_TYPE=orders prisma generate",
    "prisma:orders:push": "cross-env PRISMA_DB_TYPE=orders prisma db push",
    "prisma:orders:mig": "cross-env PRISMA_DB_TYPE=orders prisma migrate dev",
    "prisma:orders:studio": "cross-env PRISMA_DB_TYPE=orders prisma studio",
    "seed:plans": "ts-node -r tsconfig-paths/register --transpile-only libs/database/prisma/seed/seed-plans.ts",
    "seed:items": "ts-node -r tsconfig-paths/register --transpile-only libs/database/prisma/seed/seed-addon-and-variants.ts",
    "seed:tax": "ts-node -r tsconfig-paths/register --transpile-only libs/database/prisma/seed/seed-tax.ts",
    "seed:allergens": "ts-node -r tsconfig-paths/register --transpile-only libs/database/prisma/seed/seed-allergens.ts",
    "seed:themes": "ts-node -r tsconfig-paths/register --transpile-only libs/database/prisma/seed/seed-themes.ts",
    "seed:all": "pnpm seed:plans && pnpm seed:items && pnpm seed:tax && pnpm seed:allergens && pnpm seed:themes"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/s3-presigned-post": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@bull-board/api": "^6.20.5",
    "@bull-board/express": "^6.20.5",
    "@clerk/backend": "^3.2.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^11.1.16",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.19",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@prisma/client-runtime-utils": "^7.4.2",
    "@salespark/validate-vat-eu": "^1.0.5",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.13.6",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "crypto": "^1.0.1",
    "dayjs": "^1.11.20",
    "express": "^5.2.1",
    "favicons": "^7.2.0",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "libphonenumber-js": "^1.12.40",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "stripe": "^20.4.1",
    "svix": "^1.88.0",
    "ulid": "^3.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@weats/bull(|/.*)$": "<rootDir>/libs/bull/src/$1",
      "^@weats/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@weats/configs(|/.*)$": "<rootDir>/libs/configs/src/$1",
      "^@weats/encryption(|/.*)$": "<rootDir>/libs/encryption/src/$1",
      "^@weats/integrations(|/.*)$": "<rootDir>/libs/integrations/src/$1",
      "^@weats/item-core(|/.*)$": "<rootDir>/libs/item-core/src/$1",
      "^@weats/translate(|/.*)$": "<rootDir>/libs/translate/src/$1",
      "^@weats/types(|/.*)$": "<rootDir>/libs/types/src/$1",
      "^weats/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1",
      "^weats/database(|/.*)$": "<rootDir>/libs/database/src/$1"
    }
  }
}