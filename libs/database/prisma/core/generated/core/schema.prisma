/// Stores all third-party integration credentials and toggle states for an establishment.
/// All sensitive values (API keys, secrets) are stored AES-256 encrypted.
/// The `*Enabled` flags control whether the integration is actively used at runtime,
/// independently of whether credentials are present.
model EstablishmentIntegrations {
  id              String   @id @default(ulid())
  establishmentId String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // ─── EuPago ───────────────────────────────────────────────────────────────
  // Payment gateway: Multibanco, MB WAY, Visa/Mastercard.
  // eupagoApiKey    — encrypted EuPago API key
  // eupagoCryptoKey — optional encryption key for MB WAY payloads
  eupagoEnabled   Boolean @default(false)
  eupagoApiKey    String?
  eupagoCryptoKey String?

  // ─── Biziq ────────────────────────────────────────────────────────────────
  // Portuguese e-invoicing platform (AT / SAF-T compliant).
  // biziqAccountId  — encrypted Biziq account identifier
  // biziqApiKey     — encrypted Biziq API key
  // biziqCompanyVat — optional encrypted company VAT for invoice issuer data
  biziqEnabled    Boolean @default(false)
  biziqAccountId  String?
  biziqApiKey     String?
  biziqCompanyVat String?

  // ─── Viva Wallet EFT-POS ──────────────────────────────────────────────────
  // Physical card terminal integration via REST EFT-POS API (OAuth2).
  // vivaClientId     — encrypted OAuth2 client ID
  // vivaClientSecret — encrypted OAuth2 client secret
  vivaEnabled      Boolean @default(false)
  vivaClientId     String?
  vivaClientSecret String?

  // ─── SumUp Cloud API ──────────────────────────────────────────────────────────
  // Solo card reader integration via HTTPS Cloud API.
  // sumupApiKey       — encrypted Bearer token (Personal API Key or OAuth2)
  // sumupMerchantCode — encrypted merchant account code (required for reader endpoints)
  sumupEnabled      Boolean @default(false)
  sumupApiKey       String?
  sumupMerchantCode String?

  // ─── Vendus ───────────────────────────────────────────────────────────────
  // Portuguese fiscal invoicing platform (Faturas, Recibos, etc.).
  // vendusApiKey — encrypted Vendus API key (Bearer token for all requests)
  vendusEnabled Boolean @default(false)
  vendusApiKey  String?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
}

// ─── SumUp Solo Reader ────────────────────────────────────────────────────────
// Represents a Solo card reader paired to an establishment via the Cloud API.
// readerId   — SumUp reader ID returned after pairing (used for checkouts)
// name       — human-readable label set by the operator (e.g. "Caixa 1")
// deviceId   — physical device identifier (optional, from SumUp response)
model SumupReader {
  id              String        @id @default(ulid())
  establishmentId String
  readerId        String // SumUp Cloud API reader identifier
  name            String? // operator label, e.g. "Balcão Principal"
  deviceId        String? // physical device id from SumUp
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, readerId])
}

// ─── Viva Wallet Physical Terminal ────────────────────────────────────────────
// Represents a card terminal (POS) registered for an establishment.
// terminalId  — the Viva terminal serial/identifier (from their dashboard)
// posId       — the numeric POS id returned by Viva's API when the terminal is registered
// alias       — a human-readable label set by the operator (e.g. "Caixa 1")
model VivaTerminal {
  id              String        @id @default(ulid())
  establishmentId String
  terminalId      String // Viva terminal serial number / identifier
  alias           String? // operator label, e.g. "Caixa 1"
  posId           String? // Viva POS id (returned after registration, used for payments)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, terminalId])
}

/// =======================================================
/// 1. ITEM (Produto Pai / Raiz do Catálogo)
/// =======================================================
model Item {
  id              String    @id @default(ulid())
  imageId         String?
  establishmentId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// O basePrice APENAS é usado se o item NÃO tiver variantes.
  basePrice       Decimal?  @db.Decimal(10, 2)
  deletedAt       DateTime?
  posCategoryId   String?
  sku             String?

  unit     UnitType @default(UNIT)
  quantity Float    @default(1)

  status              ItemStatus           @default(ACTIVE)
  taxTableId          String
  allergens           ItemAllergen[]
  establishment       Establishment        @relation(fields: [establishmentId], references: [id])
  image               Image?               @relation("ImageItem", fields: [imageId], references: [id])
  posCategory         POSCategory?         @relation(fields: [posCategoryId], references: [id])
  taxTable            TaxTable             @relation(fields: [taxTableId], references: [id])
  modifierGroups      ItemModifierGroup[]
  itemModifierOptions ItemModifierOption[]
  translations        ItemTranslation[]
  variants            ItemVariant[]
  itemVariantGroups   ItemVariantGroup[]
  menuItemPositions   MenuItemPosition[]
  nutritionInfo       ItemNutritionInfo?
  discounts           DiscountTarget[]
  requiredItemRules   BuyXGetYRule[]       @relation("RequiredItem")
  rewardItemRules     BuyXGetYRule[]       @relation("RewardItem")
  marketingTag        MarketingTag?
  spiceLevel          SpiceLevel?
  isFeatured          Boolean              @default(false)
  hasAlcohol          Boolean              @default(false)
  attributes          ItemAttribute[]
  vendusProductId     Int?

  @@unique([establishmentId, sku])
  @@index([establishmentId, status])
  @@index([deletedAt])
}

model ItemNutritionInfo {
  id            String   @id @default(ulid())
  energyKcal    Float?
  fat           Float?
  saturatedFat  Float?
  carbohydrates Float?
  sugars        Float?
  fiber         Float?
  protein       Float?
  salt          Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  itemId        String?  @unique
  item          Item?    @relation(fields: [itemId], references: [id])
}

model VariantNutrionalInfo {
  id            String       @id @default(ulid())
  energyKcal    Float?
  fat           Float?
  saturatedFat  Float?
  carbohydrates Float?
  sugars        Float?
  fiber         Float?
  protein       Float?
  salt          Float?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  itemVariantId String?      @unique
  itemVariant   ItemVariant? @relation(fields: [itemVariantId], references: [id])
}

model ItemTranslation {
  id               String  @id @default(ulid())
  locale           String
  name             String
  shortDescription String?
  description      String?
  itemId           String
  item             Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, locale])
}

/// A. O Dicionário de Opções (Ex: "Pequena", "Média", "33cl")
model VariantOption {
  id              String                     @id @default(ulid())
  establishmentId String?
  isGlobal        Boolean                    @default(false)
  isActive        Boolean                    @default(true)
  quantity        Float
  unit            UnitType
  itemVariants    ItemVariant[]
  establishment   Establishment?             @relation(fields: [establishmentId], references: [id])
  translations    VariantOptionTranslation[]
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([establishmentId])
}

model VariantOptionTranslation {
  id              String        @id @default(ulid())
  variantOptionId String
  locale          String
  name            String
  variantOption   VariantOption @relation(fields: [variantOptionId], references: [id], onDelete: Cascade)

  @@unique([variantOptionId, locale])
}

/// B. O Grupo Local (Simetria perfeita com Modifiers)
/// Ex: "Escolha o Tamanho"
model ItemVariantGroup {
  itemId       String
  position     Int                           @default(0)
  id           String                        @id @default(ulid())
  variants     ItemVariant[]
  item         Item                          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  translations ItemVariantGroupTranslation[]

  @@index([itemId])
}

model ItemVariantGroupTranslation {
  id                 String           @id @default(ulid())
  itemVariantGroupId String
  locale             String
  name               String
  itemVariantGroup   ItemVariantGroup @relation(fields: [itemVariantGroupId], references: [id], onDelete: Cascade)

  @@unique([itemVariantGroupId, locale])
}

model ItemVariant {
  id                 String                @id @default(ulid())
  itemId             String
  price              Decimal               @db.Decimal(10, 2)
  sku                String?
  isDefault          Boolean               @default(false)
  isActive           Boolean               @default(true)
  imageId            String?
  itemVariantGroupId String
  position           Int                   @default(0)
  variantOptionId    String
  allergens          ItemVariantAllergen[]
  modifierOptions    ItemModifierOption[]
  image              Image?                @relation("ItemVariantImage", fields: [imageId], references: [id])
  item               Item                  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  group              ItemVariantGroup      @relation(fields: [itemVariantGroupId], references: [id], onDelete: Cascade)
  variantOption      VariantOption         @relation(fields: [variantOptionId], references: [id])
  nutritionInfo      VariantNutrionalInfo?
  deletedAt          DateTime?

  @@unique([itemVariantGroupId, variantOptionId])
  @@unique([id, sku])
  @@index([itemId])
  @@index([deletedAt])
}

/// A. Grupo de Modificadores (As perguntas feitas ao cliente)
model ItemModifierGroup {
  id           String                         @id @default(ulid())
  itemId       String
  minSelection Int                            @default(0)
  maxSelection Int?
  position     Int                            @default(0)
  displayMode  ModifierDisplayMode            @default(RADIO)
  isActive     Boolean                        @default(true)
  item         Item                           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  translations ItemModifierGroupTranslation[]
  options      ItemModifierOption[]
  deletedAt    DateTime?

  @@index([deletedAt])
}

model ItemModifierGroupTranslation {
  id              String            @id @default(ulid())
  modifierGroupId String
  locale          String
  name            String
  modifierGroup   ItemModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  deletedAt       DateTime?

  @@unique([modifierGroupId, locale])
}

/// B. O Dicionário de Addons Simples (Instruções de cozinha, extras)
/// Coisas que não existem como Item (Ex: "Massa Fina", "Sem Gelo")
model Addon {
  id                  String               @id @default(ulid())
  establishmentId     String?
  isActive            Boolean              @default(true)
  isGlobal            Boolean              @default(false)
  establishment       Establishment?       @relation(fields: [establishmentId], references: [id])
  translations        AddonTranslation[]
  itemModifierOptions ItemModifierOption[]

  @@index([establishmentId])
  @@index([isGlobal])
}

model AddonTranslation {
  id      String @id @default(ulid())
  addonId String
  locale  String
  name    String
  addon   Addon  @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([addonId, locale])
}

model Allergen {
  id                   String                @id @default(ulid())
  code                 AllergenCode          @unique
  itemAllergens        ItemAllergen[]
  itemVariantAllergens ItemVariantAllergen[]
}

model ItemAllergen {
  id         String   @id @default(ulid())
  itemId     String
  allergenId String
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, allergenId])
}

model ItemVariantAllergen {
  id            String   @id @default(ulid())
  itemVariantId String
  allergenId    String
  allergen      Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  itemVariant ItemVariant @relation(fields: [itemVariantId], references: [id], onDelete: Cascade)

  @@unique([itemVariantId, allergenId])
}

/// C. As Opções do Modificador (Polimorfismo!)
/// REGRA SQL (CONSTRAINT): Apenas 1 alvo pode ser preenchido (addonId, productId ou itemVariantId)
model ItemModifierOption {
  id              String            @id @default(ulid())
  modifierGroupId String
  price           Decimal?          @db.Decimal(10, 2)
  position        Int               @default(0)
  defaultQuantity Int               @default(0)
  minQuantity     Int               @default(0)
  maxQuantity     Int               @default(1)
  addonId         String?
  productId       String?
  itemVariantId   String?
  addon           Addon?            @relation(fields: [addonId], references: [id])
  itemVariant     ItemVariant?      @relation(fields: [itemVariantId], references: [id])
  group           ItemModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  product         Item?             @relation(fields: [productId], references: [id])

  @@index([modifierGroupId])
}

enum ItemStatus {
  ACTIVE
  DRAFT
  INACTIVE
}

enum AllergenCode {
  CELERY
  CRUSTACEAN
  EGG
  FISH
  GLUTEN
  LUPINS
  MILK
  MUSTARD
  NUTS
  PEANUTS
  SESAME
  SHELLFISH
  SOY
  SULFITES
}

enum ModifierDisplayMode {
  RADIO
  CHECKBOX
  QUANTITY
}

enum SpiceLevel {
  LOW
  MEDIUM
  HIGH
  EXTRA_HOT
}

model ItemAttribute {
  id     String        @id @default(ulid())
  type   AttributeType
  itemId String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, type])
}

enum AttributeType {
  VEGAN
  VEGETARIAN
  GLUTEN_FREE
  DAIRY_FREE
  HALAL
  KOSHER
}

enum MarketingTag {
  BESTSELLER
  NEW
  POPULAR
  LIMITED
}

enum UnitType {
  // --- Serving ---
  PORTION
  HALF
  SLICE
  PIECE
  PLATE
  BOWL
  UNIT

  // --- Drinks ---
  GLASS
  CUP
  SHOT
  MUG

  // --- Containers ---
  BOTTLE
  CAN

  // --- Measurements ---
  MILLILITER
  CENTILITER
  LITER
  GRAM
  KILOGRAM
  OUNCE
  POUND
}

/**
 * model ItemBundle {
 * id        String  @id @default(ulid())
 * itemId    String
 * position  Int     @default(0)
 * item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
 * options   ItemBundleOption[]
 * }
 * model ItemBundleOption {
 * id            String  @id @default(ulid())
 * bundleId      String
 * productId     String
 * minSelection  Int     @default(1)
 * maxSelection  Int     @default(1)
 * bundle        ItemBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
 * product       Item       @relation(fields: [productId], references: [id])
 * }
 */

model Menu {
  id               String   @id @default(ulid())
  position         Int      @default(0)
  isVisible        Boolean  @default(false)
  isHighlighted    Boolean  @default(false)
  color            String?
  establishmentId  String
  scheduleId       String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  maxItemsPerOrder Int?
  price            Float?

  showImages Boolean  @default(true)
  type       MenuType @default(LA_CARTE)

  establishment Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  schedule      Schedule?         @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  categories    MenuCategory[]
  translations  MenuTranslation[]

  @@index([establishmentId])
  @@index([establishmentId, position])
  @@index([scheduleId])
}

model MenuTranslation {
  id           String   @id @default(ulid())
  locale       String
  name         String
  description  String?
  observations String?
  menuId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  menu         Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([menuId, locale])
  @@index([menuId])
}

model MenuCategory {
  id            String                    @id @default(ulid())
  isVisible     Boolean                   @default(true)
  imageId       String?
  menuId        String
  position      Int                       @default(0)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  image         Image?                    @relation("ImageMenuCategory", fields: [imageId], references: [id])
  menu          Menu                      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  translations  MenuCategoryTranslation[]
  subcategories MenuSubcategory[]

  @@index([menuId])
  @@index([menuId, position])
}

model MenuCategoryTranslation {
  id         String       @id @default(ulid())
  locale     String
  name       String
  categoryId String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model MenuSubcategory {
  id           String                       @id @default(ulid())
  isVisible    Boolean                      @default(true)
  categoryId   String?
  position     Int                          @default(0)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  items        MenuItemPosition[]
  category     MenuCategory?                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  translations MenuSubcategoryTranslation[]

  @@index([categoryId])
  @@index([categoryId, position])
}

model MenuSubcategoryTranslation {
  id            String          @id @default(ulid())
  locale        String
  name          String
  description   String?
  subcategoryId String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  subcategory   MenuSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([subcategoryId, locale])
}

model MenuItemPosition {
  id            String          @id @default(ulid())
  itemId        String
  subcategoryId String
  position      Int             @default(0)
  isVisible     Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  isIncluded    Boolean         @default(false)
  item          Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  subcategory   MenuSubcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([itemId, subcategoryId])
  @@index([itemId])
  @@index([subcategoryId])
  @@index([subcategoryId, position])
}

enum MenuType {
  LA_CARTE
  RODIZIO
}

model MoloniToken {
  id               String   @id @default(cuid())
  accessToken      String
  refreshToken     String
  expiresAt        DateTime
  refreshExpiresAt DateTime
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
  establishmentId  String?  @unique

  @@map("moloni_tokens")
}

model OrderItem {
  id              String   @id @default(ulid())
  orderId         String
  itemId          String
  itemVariantId   String? // se aplicável
  quantity        Int
  basePrice       Decimal  @db.Decimal(10, 2) // preço unitário sem promoções
  modifierTotal   Decimal  @db.Decimal(10, 2) // total de modificadores
  subtotal        Decimal  @db.Decimal(10, 2) // basePrice * quantity + modifiers
  discountAmount  Decimal  @db.Decimal(10, 2) // desconto aplicado neste item
  promotionAmount Decimal  @db.Decimal(10, 2) // recompensa/promo aplicada
  finalPrice      Decimal  @db.Decimal(10, 2) // subtotal - discountAmount - promotionAmount
  promotionId     String? // referência a promoção aplicada
  discountId      String? // referência a desconto aplicado
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

