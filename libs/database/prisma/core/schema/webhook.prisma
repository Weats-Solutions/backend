model WebhookEvent {
  id          String   @id @default(ulid())
  provider    String
  eventId     String
  eventType   String
  status      String
  retryCount  Int      @default(0)
  lastError   String?
  requestId   String?  @unique  // Para distribuída race condition protection
  processedAt DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider])
  @@index([status])
  @@index([expiresAt])
  @@index([requestId])
}
