<!DOCTYPE html
    PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html dir="ltr" lang="en">

<head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <meta name="x-apple-disable-message-reformatting" />
</head>

<style>
    strong {
        color: #2B7FFF;
    }
</style>

<body style='background-color:#ffffff;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif'>
    <table align="center" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
        style="max-width:560px;margin:0 auto;padding:40px 0 48px">
        <tbody>
            <tr style="width:100%">
                <td>
                    <h1
                        style="font-size:24px;letter-spacing:-0.5px;line-height:1.3;font-weight:400;color:#484848;margin:0 0 8px">
                        Invitation to join the team! 🎉
                    </h1>

                    <p style="font-size:17px;line-height:1.6;margin:0 0 20px;color:#3c4149;">
                        Hello, <strong>{{firstName}} {{lastName}}</strong>,<br /><br />
                        You have been invited to join the <strong>{{establishmentName}}</strong> team
                        through the <strong>{{saasName}}</strong> platform.
                        <br /><br />
                        This connection will allow you to access the establishment's management tools, collaborate
                        with the team, and perform your role more simply and effectively.
                        <br /><br />
                        To accept the invitation and complete your registration, simply click the button below:
                    </p>

                    <table align="center" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                        style="padding:16px 0 32px">
                        <tbody>
                            <tr>
                                <td>
                                    <a href="{{redirectUrl}}"
                                        style="display:block;text-decoration:none;background-color:#2B7FFF;border-radius:10px;font-weight:600;color:#fff;font-size:15px;text-align:center;padding:16px 23px"
                                        target="_blank">
                                        Accept invitation
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <p style="font-size:15px;line-height:1.6;margin:0 0 20px;color:#3c4149;">
                        If you do not recognize this invitation, you can simply ignore this email.
                    </p>

                    <hr style="width:100%;border:none;border-top:1px solid #eaeaea;margin:8px 0 24px" />
                    <a href="https://{{saasName}}.com" style="color:#b4becc;text-decoration:none;font-size:14px"
                        target="_blank">{{saasName}} — {{saasAddress}}</a>
                </td>
            </tr>
        </tbody>
    </table>
</body>

</html>