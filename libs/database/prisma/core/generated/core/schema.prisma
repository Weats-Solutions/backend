  TIMESTRAL
  YEARLY
}

enum FeatureType {
  BOOLEAN
  QUANTITY
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum UnitType {
  CUP
  DOSE
  PEOPLE
  PIECE
  PORTION
  SLICE
  UNIT
  GLASS
  MILLILITRE
  CENTILITRE
  LITRE
  GRAM
  KILOGRAM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ServicePointType {
  TABLE
  BOOTH
  COUNTER
  TERRACE
  ROOM
  SUITE
  POOL_SIDE
  SUNBED
  CABANA
  SEAT
  SECTOR
  VIP_BOX
  STANDING_TABLE
  LOUNGE_AREA
  PICKUP_POINT
  PARKING_SPOT
