model Image {
  id                  String               @id @default(ulid())
  cloudflareImageId   String               @unique
  fileName            String
  url                 String
  fileSize            Float
  metadata            Json?
  establishmentId     String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  bannerUsedInBrands  EstablishmentBrand[] @relation("BannerImage")
  logoUsedInBrands    EstablishmentBrand[] @relation("LogoImage")
  bannerUsedInConfigs HomePageConfig[]     @relation("BannerHomePageImage")
  logoUsedInConfigs   HomePageConfig[]     @relation("LogoHomePageImage")
  establishment       Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  item                Item[]               @relation("ImageItem")
  menuCategory        MenuCategory[]       @relation("ImageMenuCategory")

  @@index([establishmentId])
}
